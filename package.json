{
  "name": "apex-circuit",
  "productName": "Apex Circuit",
  "version": "2.0.0",
  "description": "Build. Tune. Race. A cross-platform 3D racing game.",
  "main": "electron/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "node electron/build.js mac",
    "build:win": "node electron/build.js win",
    "build:linux": "node electron/build.js linux",
    "build:all": "node electron/build.js all",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
